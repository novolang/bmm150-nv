@test
fn test_the_axes_are_enabled_by_clearing_their_bits() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.regs.insert(0x4E, 0x87)
    test.assert(bmm150.axes_write(d, true, true, true))
    test.assert_eq(reg_of(c, 0x4E), 0x87)
    test.assert(bmm150.axes_write(d, false, true, true))
    test.assert_eq(reg_of(c, 0x4E), 0x8F)
    test.assert(bmm150.axes_write(d, true, false, true))
    test.assert_eq(reg_of(c, 0x4E), 0x97)
    test.assert(bmm150.axes_write(d, true, true, false))
    test.assert_eq(reg_of(c, 0x4E), 0xA7)
    test.assert(bmm150.axes_write(d, false, false, false))
    test.assert_eq(reg_of(c, 0x4E), 0xBF)

@test
fn test_the_ready_pin_and_the_interrupt_pin_are_set_in_their_own_bits() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.regs.insert(0x4E, 0x00)
    test.assert(bmm150.drdy_pin_write(d, true, true))
    test.assert_eq(reg_of(c, 0x4E), 0x84)
    test.assert(bmm150.drdy_pin_write(d, true, false))
    test.assert_eq(reg_of(c, 0x4E), 0x80)
    test.assert(bmm150.drdy_pin_write(d, false, false))
    test.assert_eq(reg_of(c, 0x4E), 0x00)
    test.assert(bmm150.int_pin_write(d, true, true, true))
    test.assert_eq(reg_of(c, 0x4E), 0x43)
    test.assert(bmm150.int_pin_write(d, true, false, false))
    test.assert_eq(reg_of(c, 0x4E), 0x40)
    test.assert(bmm150.int_pin_write(d, false, false, false))
    test.assert_eq(reg_of(c, 0x4E), 0x00)

@test
fn test_the_thresholds_and_the_enables_are_written_whole() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    test.assert(bmm150.thresholds_write(d, 12, 200))
    test.assert_eq(reg_of(c, 0x4F), 12)
    test.assert_eq(reg_of(c, 0x50), 200)
    test.assert(bmm150.int_enable_write(d, 0xF8))
    test.assert_eq(reg_of(c, 0x4D), 0xF8)
    c.regs.insert(0x4A, 0x41)
    test.assert_eq(bmm150.int_status(d), 0x41)
    c.ro.insert(0x50, 1)
    test.assert(not bmm150.thresholds_write(d, 1, 2))
    c.st.insert(4, 0)
    test.assert_eq(bmm150.int_status(d), 0)

// ── Self-test ────────────────────────────────────────────────────────

@test
fn test_the_normal_self_test_puts_the_part_to_sleep_sets_the_bit_and_reads_the_axes() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.regs.insert(0x4C, 0x28)
    c.st.insert(61, 7)
    c.st.insert(60, 3)
    test.assert_eq(bmm150.self_test_normal(d), 7)
    test.assert(bmm150.self_test_passed(7))
    // Sleep first, then the self-test bit, written without a read-back.
    writes_are(c, [0x4C, 0x2E, 0x4C, 0x2F])
    c.regs.insert(0x42, 0)
    c.regs.insert(0x44, 0)
    c.regs.insert(0x46, 0)
    c.st.insert(61, 5)
    test.assert_eq(bmm150.self_test_normal(d), 5)
    test.assert(not bmm150.self_test_passed(5))
    c.regs.insert(0x42, 0)
    c.regs.insert(0x44, 0)
    c.regs.insert(0x46, 0)
    c.st.insert(61, 2)
    test.assert_eq(bmm150.self_test_normal(d), 2)

@test
fn test_a_self_test_that_never_finishes_or_a_silent_part_gives_minus_one() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.st.insert(60, -1)
    test.assert_eq(bmm150.self_test_normal(d), -1)
    let c2 = chip_on()
    c2.st.insert(4, 0)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c2)), -1)
    // Sleep taken, then the part is gone before the OPMODE read.
    let c3 = chip_on()
    c3.st.insert(70, 2)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c3)), -1)
    // The self-test bit refused.
    let c4 = chip_on()
    c4.st.insert(70, 4)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c4)), -1)
    // The part ends the wait and then fails to give the results.
    let c5 = chip_on()
    c5.st.insert(70, 5)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c5)), -1)
    // The wait ends and the part is gone before the results are read.
    let c6 = chip_on()
    c6.st.insert(70, 6)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c6)), -1)
    // The part gives the mode and then no answer to the read of OPMODE.
    let c7 = chip_on()
    c7.st.insert(70, 3)
    test.assert_eq(bmm150.self_test_normal(i2c_dut(c7)), -1)

// ── Power and bring-up ───────────────────────────────────────────────

@test
fn test_the_power_bit_is_set_and_cleared_and_clearing_it_forgets_the_trim_data() [io, hw, mutate]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(bmm150.power_on(d))
    test.assert_eq(reg_of(c, 0x4B), 1)
    test.assert(bmm150.trim_load(d))
    test.assert(bmm150.trim_ready())
    c.regs.insert(0x51, 4)
    test.assert(bmm150.suspend(d))
    test.assert_eq(reg_of(c, 0x4B), 0)
    test.assert(not bmm150.trim_ready())
    // Suspend loses the registers but POWER.
    test.assert_eq(reg_of(c, 0x51), 0)
    c.st.insert(4, 0)
    test.assert(not bmm150.power_on(d))

@test
fn test_a_soft_reset_sets_both_bits_and_polls_until_they_clear() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.regs.insert(0x51, 4)
    c.st.insert(44, 3)
    test.assert(bmm150.soft_reset(d))
    writes_are(c, [0x4B, 0x83])
    test.assert_eq(reg_of(c, 0x4B), 1)
    test.assert_eq(reg_of(c, 0x51), 0)
    test.assert_eq(reg_of(c, 0x4C), 0x06)

@test
fn test_a_soft_reset_is_ignored_in_suspend_so_the_bits_never_set() [io, hw, mutate]
    let c = chip()
    let d = i2c_dut(c)
    // With the power control bit clear nothing is reset; the poll sees the bits
    // clear at once, which is why `start` sets the power bit first.
    c.regs.insert(0x4B, 0x00)
    c.regs.insert(0x51, 4)
    c.st.insert(70, 0)
    test.assert(bmm150.soft_reset(d))
    test.assert_eq(reg_of(c, 0x51), 0)

@test
fn test_a_soft_reset_that_never_clears_or_a_silent_part_fails() [io, hw, mutate]
    let c = chip_on()
    let d = i2c_dut(c)
    c.st.insert(44, -1)
    test.assert(not bmm150.soft_reset(d))
    let c2 = chip_on()
    c2.st.insert(4, 0)
    test.assert(not bmm150.soft_reset(i2c_dut(c2)))
    let c3 = chip_on()
    c3.st.insert(70, 1)
    test.assert(not bmm150.soft_reset(i2c_dut(c3)))
    let c4 = chip_on()
    c4.st.insert(70, 2)
    test.assert(not bmm150.soft_reset(i2c_dut(c4)))

@test
fn test_the_bring_up_powers_the_part_resets_it_cycles_the_power_and_sets_the_regular_preset() [io, hw, mutate]
    let c = chip()
    let d = i2c_dut(c)
    // The part answers its chip id only after 5 reads of start-up time, and its
    // reset bits clear after 2 reads.
    c.st.insert(41, 5)
    c.st.insert(44, 2)
    test.assert(bmm150.start(d))
    // Power on; the soft reset; suspend; power on; the regular preset (REPXY 4,
    // REPZ 14, 10 Hz in sleep); the data-ready pin; normal mode.
    writes_are(c, [0x4B,
        0x01,
        0x4B,
        0x83,
        0x4B,
        0x00,
        0x4B,
        0x01,
        0x51,
        0x04,
        0x52,
        0x0E,
        0x4C,
        0x06,
        0x4E,
        0x87,
        0x4C,
        0x00])
    test.assert(bmm150.trim_ready())
    test.assert_eq(bmm150.trim_get().xyz1, 7500)
    test.assert_eq(reg_of(c, 0x4C), 0x00)
    test.assert(bmm150.mode_read(d) == BmmMode.BmmNormal)
    test.assert_eq(bmm150.rate_read(d), 10)
    test.assert_eq(at(c.st, 22), 400000)

@test
fn test_the_bring_up_over_spi_runs_the_same_settings() [io, hw, mutate]
    let c = chip()
    let d = spi_dut(c)
    test.assert(bmm150.start(d))
    writes_are(c, [0x4B,
        0x01,
        0x4B,
        0x83,
        0x4B,
        0x00,
        0x4B,
        0x01,
        0x51,
        0x04,
        0x52,
        0x0E,
        0x4C,
        0x06,
        0x4E,
        0x87,
        0x4C,
        0x00])

@test
fn test_a_part_that_never_answers_its_chip_id_or_is_not_a_bmm150_is_refused() [io, hw, mutate]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x40, 0x33)
    test.assert(not bmm150.start(d))
    // It was powered, and nothing else was written.
    writes_are(c, [0x4B, 0x01])
    let c2 = chip()
    c2.st.insert(4, 0)
    test.assert(not bmm150.start(i2c_dut(c2)))
    test.assert(not bmm150.start(spi_dut(c2)))

@test
fn test_a_wiring_the_bus_cannot_use_is_refused_before_anything_is_sent() [io, hw, mutate]
    let c = chip()
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    test.assert(not bmm150.start(I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: w }))
    log_is(c, [])

@test
fn test_each_step_of_the_bring_up_that_fails_ends_it() [io, hw, mutate]
    // The part goes silent after n transactions, for each n up to the end of
    // the trim read; the start never reports success.
    let c1 = chip()
    c1.st.insert(70, 1)
    test.assert(not bmm150.start(i2c_dut(c1)))
    let c2 = chip()
    c2.ro.insert(0x4B, 1)
    test.assert(not bmm150.start(i2c_dut(c2)))
    let c3 = chip()
    c3.st.insert(44, -1)
    test.assert(not bmm150.start(i2c_dut(c3)))
    // The chip id does not read 0x32 within the polls the driver makes.
    let c4 = chip()
    c4.st.insert(41, 5000)
    test.assert(not bmm150.start(i2c_dut(c4)))
    // A start-up of a few reads after each power-up is waited out.
    let c5 = chip()
    c5.st.insert(41, 40)
    test.assert(bmm150.start(i2c_dut(c5)))
    test.assert_eq(bmm150.trim_get().xyz1, 7500)

@test
fn test_a_part_that_dies_in_the_middle_of_the_bring_up_ends_it() [io, hw, mutate]
    // One transaction at a time: the part answers n and then goes silent.  A
    // complete bring-up is `total` transactions.
    let whole = chip()
    test.assert(bmm150.start(i2c_dut(whole)))
    let total = transactions(whole)
    for n in 1..total
        let c = chip()
        c.st.insert(70, n)
        test.assert(not bmm150.start(i2c_dut(c)))
    let last = chip()
    last.st.insert(70, total)
    test.assert(bmm150.start(i2c_dut(last)))

@test
fn test_a_part_that_refuses_the_preset_or_the_last_settings_fails_the_bring_up() [io, hw, mutate]
    let c = chip()
    c.ro.insert(0x51, 1)
    test.assert(not bmm150.start(i2c_dut(c)))
    let c2 = chip()
    c2.ro.insert(0x4E, 1)
    test.assert(not bmm150.start(i2c_dut(c2)))
    let c3 = chip()
    c3.ro.insert(0x4C, 1)
    test.assert(not bmm150.start(i2c_dut(c3)))

// ── The two types ────────────────────────────────────────────────────
//
// The types are built over the host's board handles, which answer as absent
// hardware here: each method answers its "no part" value.  This runs the lines
// of the two types that forward to the functions above.

@test
fn test_the_i2c_type_over_absent_hardware() [io, hw, mutate]
    bmm150.trim_clear()
    let w = dev_bus.wiring_i2c(0, 0x10)
    let p = Bmm150.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x40) == None)
    test.assert(not p.set_reg(0x51, 1))
    test.assert(p.mode() == BmmMode.BmmSleep)
    test.assert(not p.set_mode(BmmMode.BmmNormal))
    test.assert_eq(p.set_rate_hz(10), 0)
    test.assert(not p.set_preset(BmmPreset.BmmRegular))
    test.assert(is_none(p.measure()))
    test.assert_eq(p.self_test(), -1)
    test.assert_eq(p.irq_level(), -1)
    test.assert(is_none(p.mag_read()))
    test.assert(not p.mag_ready())
    test.assert_eq(p.mag_rate_hz(), 0)
    test.assert(p.device_id() == None)

@test
fn test_the_spi_type_over_absent_hardware() [io, hw, mutate]
    bmm150.trim_clear()
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    let p = Bmm150Spi.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x40) == None)
    test.assert(not p.set_reg(0x51, 1))
    test.assert(p.mode() == BmmMode.BmmSleep)
    test.assert(not p.set_mode(BmmMode.BmmNormal))
    test.assert_eq(p.set_rate_hz(10), 0)
    test.assert(not p.set_preset(BmmPreset.BmmRegular))
    test.assert(is_none(p.measure()))
    test.assert_eq(p.self_test(), -1)
    test.assert_eq(p.irq_level(), -1)
    test.assert(is_none(p.mag_read()))
    test.assert(not p.mag_ready())
    test.assert_eq(p.mag_rate_hz(), 0)
    test.assert(p.device_id() == None)
