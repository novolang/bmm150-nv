// bmm150 — Bosch's BMM150 three-axis geomagnetic sensor, on its I2C or its
// SPI bus, as devices-nv's `Magnetometer` and `Identifiable`.
//
// The facts below are from Bosch Sensortec's data sheet "BMM150: Geomagnetic
// Sensor", BST-BMM150-DS001-05, revision 1.4, April 2020, and from the
// compensation in Bosch Sensortec's BMM150_SensorAPI (the fixed-point form of
// `bmm150.c`, BSD-3-Clause), whose formulas are the ones the data sheet's
// section 4.3.2 points at.  Tables and sections are named by number.  Where
// the sheet and the drivers read for this one disagree, the site says which
// was taken.
//
// The register map (§ 5.2), as this driver uses it:
//
//   0x40  CHIP_ID        0x32, readable only while the power control bit is
//                        set
//   0x42  DATA X         13 bits: LSB register bits 7 to 3, MSB register
//   0x43                 all 8 bits
//   0x44  DATA Y         13 bits, the same
//   0x45
//   0x46  DATA Z         15 bits: LSB register bits 7 to 1
//   0x47
//   0x48  RHALL          14 bits: LSB register bits 7 to 2, and DRDY in bit 0
//   0x49
//   0x4A  INT STATUS     data overrun, overflow, the threshold flags
//   0x4B  POWER          soft reset (7 and 1), SPI3en (2), power control (0)
//   0x4C  OPMODE         advanced self-test (7:6), data rate (5:3), opmode
//                        (2:1), self-test (0)
//   0x4D  INT ENABLE     data overrun, overflow, the threshold enables
//   0x4E  AXES / PINS    DRDY pin (7), INT pin (6), channels Z, Y, X (5:3,
//                        active low), DRDY polarity (2), latch (1), INT
//                        polarity (0)
//   0x4F  LOW THRESHOLD  0x50 HIGH THRESHOLD
//   0x51  REPXY          0x52 REPZ
//   0x5D to 0x71         the trim registers DIG_X1 to DIG_XY1, factory data
//
// The power states (§ 4.2).  After power-on the part is in suspend mode, where
// only the power control bit and SPI3en can be accessed and a read of the
// chip id returns 0x00 on I2C and floats on SPI.  Setting the power control
// bit moves it to sleep mode, after the start-up time of 3 ms (Table 1), and
// from sleep it goes to normal mode (periodic measurements at a data rate) or
// to forced mode (one measurement, after which OPMODE reads sleep again).  The
// driver has no timer, so it waits the 3 ms by polling the chip id.
//
// The data (§ 4.3).  A burst read of 0x42 to 0x49 returns one consistent set
// of X, Y, Z and RHALL; while any data register is being read the part holds
// new data in shadow registers, so the driver reads the eight bytes at once.
// The DRDY bit sits in 0x48, a data register, so reading it counts as reading
// data and clears it.  The raw values are not milli-anything: the host
// compensates them with the trim registers and the RHALL resistance reading,
// which `comp_x`, `comp_y` and `comp_z` do in integers as the SensorAPI does.
//
// Units.  The SensorAPI answers in microtesla with the last division by 16
// done.  The driver does that division last, after scaling to nanotesla, so a
// reading keeps 62.5 nT of the 1/16 microtesla the formula carries.
//
// The overflow sentinel.  The SensorAPI answers -32768 microtesla for an axis
// whose raw value is the ADC's overflow marker (-4096 on X and Y, -16384 on Z)
// or whose trim data makes the formula undefined.  The driver answers that
// value, -32 768 000 nanotesla, `OVERFLOW_NT`, and `is_overflow` says whether
// a reading carries it.
//
// The two buses.  On I2C the part answers at 0x10 to 0x13, chosen by the CSB
// and SDO pins (Table 30), and the register address advances after every
// byte of a read.  On SPI a transaction is a command byte, then data, inside
// one chip-select window: bit 7 is RW (1 reads) and bits 6 to 0 are the
// register (§ 6.1); a read of several registers just keeps clocking.  The part
// accepts SPI mode 0 and mode 3 and picks between them from SCK after the
// falling edge of CSB, up to 10 MHz; the driver uses mode 3 at 4 MHz.  The
// PS pin selects the interface in hardware; the 3-wire mode (SPI3en) is not
// implemented.
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/bosch/bmm150` and Bosch Sensortec's BMM150_SensorAPI.  Each
// fix kept is named at its site.
//
// The trim data is module state, because `Magnetometer` gives a method a
// plain `self`: the driver holds the state of one BMM150 per program.
// `trim_load` reads it from the part, `trim_clear` forgets it, and
// `sample_read` loads it when it is missing.  Everything else is read from the
// part in the same transaction as the sample.
//
// A bus enters through `Bmm150Port`, which a type that holds a bus implements:
// `Bmm150` for an I2C bus and `Bmm150Spi` for an SPI bus.  The framing of each
// bus is the generic functions `i2c_read_into`, `i2c_write`, `spi_read_into`
// and `spi_write`, so a test runs them over a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut, TimerAsync, AsyncEdge }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_mag.{ MagNanoT, MagStatus, Magnetometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let CHIP_ID      = 0x40
let DATA_X_LSB   = 0x42
let DATA_RHALL_L = 0x48
let INT_STATUS   = 0x4A
let POWER        = 0x4B
let OPMODE       = 0x4C
let INT_ENABLE   = 0x4D
let AXES_PINS    = 0x4E
let LOW_THS      = 0x4F
let HIGH_THS     = 0x50
let REP_XY       = 0x51
let REP_Z        = 0x52
let DIG_X1       = 0x5D
let DIG_Z4_LSB   = 0x62
let DIG_Z2_LSB   = 0x68

// CHIP_ID's value.
let ID_BMM150 = 0x32

// The SPI command byte's RW bit.
let SPI_READ = 0x80

// POWER: the two soft reset trigger bits and the power control bit.
let POWER_RESET   = 0x82
let POWER_CONTROL = 0x01
// OPMODE: the opmode field, the data rate field, the self-test bit.
let OPMODE_MODE_MASK = 0x06
let OPMODE_ODR_MASK  = 0x38
let OPMODE_SELF_TEST = 0x01
// AXES_PINS: the DRDY pin enable, its polarity, the INT pin enable, the
// latch, the INT polarity and the three channel disables.
let PINS_DRDY_EN  = 0x80
let PINS_INT_EN   = 0x40
let PINS_CHANNELS = 0x38
let PINS_DRDY_POL = 0x04
let PINS_LATCH    = 0x02
let PINS_INT_POL  = 0x01
// RHALL's LSB register: the data-ready flag.
let DRDY = 0x01
// INT STATUS: the overflow flag.
let INT_OVERFLOW = 0x40

// The ADC's overflow markers, and the value that stands for them.
let XY_OVERFLOW_ADC = -4096
let Z_OVERFLOW_ADC  = -16384
let OVERFLOW_NT     = -32768000

// The trim values: how many, and where each sits in the module's list.
let TRIM_LEN = 11

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ   = 400000
let SPI_HZ   = 4000000
let SPI_MODE = 3

// The most polls of a flag one wait makes.  The start-up takes 3 ms and a
// read over I2C about 100 us; a forced measurement at the high-accuracy
// preset takes about 49 ms; the self-test takes 2 ms.
let ID_POLLS     = 1000
let RESET_POLLS  = 200
let FORCED_POLLS = 5000
let TEST_POLLS   = 400

// The operation mode of the part (§ 4.2, Table 18).  Suspend is the power
// control bit and not a mode of OPMODE.
pub @value
enum BmmMode
    BmmNormal
    BmmForced
    BmmSleep

// The recommended presets of repetitions and data rate (§ 4.2.4, Table 3).
pub @value
enum BmmPreset
    BmmLowPower
    BmmRegular
    BmmEnhanced
    BmmHighAccuracy

// The factory trim data, as the SensorAPI names it: DIG_X1, DIG_Y1, DIG_Z4,
// DIG_X2, DIG_Y2, DIG_Z2, DIG_Z1, DIG_XYZ1, DIG_Z3, DIG_XY2 and DIG_XY1.
pub @value
struct Bmm150Trim
    x1: Int
    y1: Int
    z4: Int
    x2: Int
    y2: Int
    z2: Int
    z1: Int
    xyz1: Int
    z3: Int
    xy2: Int
    xy1: Int

// A bus the part is on.  `setup` makes the bus and the pins ready and answers
// whether the wiring suits the bus; `read_regs` reads `n` registers from `reg`
// in one transaction; `write_reg` writes one register; `irq_level` answers
// the level of the data-ready pin.
pub trait Bmm150Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// The command byte that goes out for a read from `reg` on SPI: RW set.
fn spi_cmd_of(reg: Int) -> Int
    SPI_READ | (reg & 0x7F)

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a write
// of the register and a repeated start: whether the part answered.  The
// address advances by itself.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the part
// acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: whether
// it ran, which is whether the wiring has a chip select.  An absent part
// reads 0xFF, which the callers check for.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int, n: Int,
                                            var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push(spi_cmd_of(reg) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, RW clear: whether
// it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the data-ready pin an input, the bus at 400 kHz.
// The wiring needs an address, which the answer says.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin never
// drives low and the part stays on the bus it was reset on, then an output;
// the data-ready pin an input; the bus at 4 MHz in mode 3.  Answers whether
// the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's data-ready line on the board, 1 or 0, or -1 for a
// wiring with no pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Bmm150Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part holds
// the value.  A register with a bit that clears itself is written with
// `write_reg`.
pub fn reg_write<P: Bmm150Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `bits`, leaving the others:
// whether the part took it.
pub fn reg_update<P: Bmm150Port>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (bits & mask))

// The bits of a register with `bit` set when `on`.
fn flag(on: Bool, bit: Int) -> Int
    if on
        return bit
    0

// `v` held to the range `lo` to `hi`.
fn clamp(v: Int, lo: Int, hi: Int) -> Int
    if v < lo
        return lo
    if v > hi
        return hi
    v

// ── Identity ─────────────────────────────────────────────────────────

// CHIP_ID as a `DeviceId`, or `None` when no part answers or the part is in
// suspend mode, where the byte reads 0x00 on I2C and 0xFF on an SPI bus no
// part drives.  Only a part that has its power control bit set answers.
pub fn id_read<P: Bmm150Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, CHIP_ID) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// Polls CHIP_ID until it reads 0x32, at most `ID_POLLS` times: whether it
// did.  This is how the 3 ms start-up is waited for without a timer.
fn wait_chip_id<P: Bmm150Port>(p: P) -> Bool [hw]
    for _i in 0..ID_POLLS
        if reg_read(p, CHIP_ID) == Some(ID_BMM150)
            return true
    false

// ── The trim data and the compensation ───────────────────────────────

var trim: Vec[Int; 16] = Vec.new()

// Forgets the trim data: the next sample reads it again.
pub fn trim_clear() [mutate]
    trim.clear()

// Whether the module holds the part's trim data.
pub fn trim_ready() -> Bool [mutate]
    trim.len() == TRIM_LEN

// The trim data the module holds, all zero when it holds none.
pub fn trim_get() -> Bmm150Trim [mutate]
    if not trim_ready()
        return Bmm150Trim { x1: 0,
            y1: 0,
            z4: 0,
            x2: 0,
            y2: 0,
            z2: 0,
            z1: 0,
            xyz1: 0,
            z3: 0,
            xy2: 0,
            xy1: 0 }
    Bmm150Trim { x1: trim[0],
        y1: trim[1],
        z4: trim[2],
        x2: trim[3],
        y2: trim[4],
        z2: trim[5],
        z1: trim[6],
        xyz1: trim[7],
        z3: trim[8],
        xy2: trim[9],
        xy1: trim[10] }

// The signed 8-bit value of a register byte.
fn s8(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend(b[i] as Int, 8)

// The signed 16-bit value of two register bytes, low byte first.
fn s16(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)

// Reads the trim registers and keeps them: whether the part answered all
// three reads.  The SensorAPI reads DIG_X1 and DIG_Y1 (0x5D, 2 bytes), then
// DIG_Z4 to DIG_Y2 (0x62, 4 bytes), then DIG_Z2 to DIG_XY1 (0x68, 10 bytes).
// DIG_Z1 is unsigned, DIG_XYZ1 is 15 bits, DIG_XY1 is an unsigned byte and the
// others are signed.
pub fn trim_load<P: Bmm150Port>(p: P) -> Bool [hw, mutate]
    var a: DevBytes = Vec.new()
    var b: DevBytes = Vec.new()
    var c: DevBytes = Vec.new()
    if not p.read_regs(DIG_X1, 2, var a)
        return false
    if not p.read_regs(DIG_Z4_LSB, 4, var b)
        return false
    if not p.read_regs(DIG_Z2_LSB, 10, var c)
        return false
    trim.clear()
    let _ = trim.push(s8(a, 0))
    let _ = trim.push(s8(a, 1))
    let _ = trim.push(s16(b, 0))
    let _ = trim.push(s8(b, 2))
    let _ = trim.push(s8(b, 3))
    let _ = trim.push(s16(c, 0))
    let _ = trim.push((c[3] as Int << 8) | c[2] as Int)
    let _ = trim.push(((c[5] as Int & 0x7F) << 8) | c[4] as Int)
    let _ = trim.push(s16(c, 6))
    let _ = trim.push(s8(c, 8))
    let _ = trim.push(c[9] as Int)
    true

// The value of the formula's 16-bit signed wrap: the SensorAPI computes the
// first correction in 16-bit registers.
fn wrap16(v: Int) -> Int
    dev_bus.dev_sign_extend(v, 16)

// Whether a compensated value is the overflow sentinel.
pub fn is_overflow(nt: Int) -> Bool
    nt == OVERFLOW_NT

// The compensated field of the X or Y axis in nanotesla (§ 4.3.2, the
// SensorAPI's `compensate_x` and `compensate_y`): `raw` is the 13-bit value,
// `rhall` the 14-bit resistance, `off1` is DIG_X1 or DIG_Y1 and `off2` DIG_X2
// or DIG_Y2.  `OVERFLOW_NT` for the ADC's overflow marker and for a trim set
// that makes the formula undefined.
//
// The SensorAPI wraps one intermediate value to 16 bits and the final one
// before the division by 16; `Int` is wider, and the two differ only above
// about 2 000 microtesla, beyond the sensor's range of 1 300 microtesla.
pub fn comp_xy(xyz1: Int, xy1: Int, xy2: Int, off1: Int, off2: Int, raw: Int, rhall: Int) -> Int
    if raw == XY_OVERFLOW_ADC
        return OVERFLOW_NT
    var r0 = 0
    if rhall != 0
        r0 = rhall
    elif xyz1 != 0
        r0 = xyz1
    if r0 == 0
        return OVERFLOW_NT
    let r = wrap16(xyz1 * 16384 / r0 - 0x4000)
    let p4 = xy2 * (r * r / 128)
    let p6 = (p4 + r * (xy1 * 128)) / 512
    let p8 = (p6 + 0x100000) * (off2 + 0xA0) / 4096
    let a = raw * p8 / 8192
    (a + off1 * 8) * 125 / 2

// The compensated field of the Z axis in nanotesla (the SensorAPI's
// `compensate_z`): `raw` is the 15-bit value.  The result before the division
// by 16 is held to ±32767, as the SensorAPI holds it.  `OVERFLOW_NT` for the
// ADC's overflow marker, for a zero in the trim data or the resistance that
// the formula divides by, and for a zero divisor.
pub fn comp_z(z1: Int, z2: Int, z3: Int, z4: Int, xyz1: Int, raw: Int, rhall: Int) -> Int
    if raw == Z_OVERFLOW_ADC
        return OVERFLOW_NT
    if z2 == 0 or z1 == 0 or rhall == 0 or xyz1 == 0
        return OVERFLOW_NT
    let c1 = z3 * (rhall - xyz1) / 4
    let c2 = (raw - z4) * 32768
    let c4 = wrap16((z1 * (rhall * 2) + 32768) / 65536)
    let den = z2 + c4
    if den == 0
        return OVERFLOW_NT
    let r = clamp((c2 - c1) / den, -32767, 32767)
    r * 125 / 2

// The three axes in nanotesla from the raw values and the trim data.
pub fn compensate(t: Bmm150Trim, x: Int, y: Int, z: Int, rhall: Int) -> MagNanoT
    MagNanoT { x: comp_xy(t.xyz1, t.xy1, t.xy2, t.x1, t.x2, x, rhall),
        y: comp_xy(t.xyz1, t.xy1, t.xy2, t.y1, t.y2, y, rhall),
        z: comp_z(t.z1, t.z2, t.z3, t.z4, t.xyz1, z, rhall) }

// ── Samples ──────────────────────────────────────────────────────────

// The most recent sample in nanotesla, from one burst of 0x42 to 0x49 and the
// trim data, which is read first if the module holds none: `None` when the
// part did not answer.  An axis the formula cannot compute carries
// `OVERFLOW_NT`.  In sleep or suspend mode the registers hold the last
// measurement or nothing.
pub fn sample_read<P: Bmm150Port>(p: P) -> ?MagNanoT [hw, mutate]
    if not trim_ready()
        if not trim_load(p)
            return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(DATA_X_LSB, 8, var b)
        return None
    let x = wrap16((b[1] as Int << 8) | b[0] as Int) >> 3
    let y = wrap16((b[3] as Int << 8) | b[2] as Int) >> 3
    let z = wrap16((b[5] as Int << 8) | b[4] as Int) >> 1
    let rhall = ((b[7] as Int << 8) | b[6] as Int) >> 2
    Some(compensate(trim_get(), x, y, z, rhall))

// Whether a new set of data has been written since the last read: RHALL's
// DRDY.  Reading it reads a data register, so the flag clears.
pub fn sample_ready<P: Bmm150Port>(p: P) -> Bool [hw]
    ((reg_read(p, DATA_RHALL_L) ?? 0) & DRDY) != 0

// ── Operation mode and rate ──────────────────────────────────────────

// The OPMODE field a mode writes.
pub fn mode_bits(m: BmmMode) -> Int
    match m
        BmmNormal => 0
        BmmForced => 1
        BmmSleep  => 3

// The mode an OPMODE byte selects.  Opmode 10 is reserved; the driver reads
// it as sleep.
pub fn mode_of_opmode(v: Int) -> BmmMode
    match (v >> 1) & 3
        0 => BmmNormal
        1 => BmmForced
        _ => BmmSleep

// The mode the part is in, sleep when it does not answer.
pub fn mode_read<P: Bmm150Port>(p: P) -> BmmMode [hw]
    mode_of_opmode(reg_read(p, OPMODE) ?? OPMODE_MODE_MASK)

// Sets the mode, leaving the rate: whether the part took it.  A part in
// suspend is first moved to sleep.  Entering forced mode is `forced_start`,
// since the field reads sleep again when the measurement ends.
pub fn mode_write<P: Bmm150Port>(p: P, m: BmmMode) -> Bool [hw]
    if mode_bits(m) == 1
        return forced_start(p)
    reg_update(p, OPMODE, OPMODE_MODE_MASK, mode_bits(m) << 1)

// The rate in hertz a data rate code selects (Table 17).
pub fn rate_hz_of_code(code: Int) -> Int
    match code & 7
        0 => 10
        1 => 2
        2 => 6
        3 => 8
        4 => 15
        5 => 20
        6 => 25
        _ => 30

// The code of the slowest rate at or above `hz`, or of the fastest, 30 Hz.
pub fn code_for_rate(hz: Int) -> Int
    if hz <= 2
        return 1
    if hz <= 6
        return 2
    if hz <= 8
        return 3
    if hz <= 10
        return 0
    if hz <= 15
        return 4
    if hz <= 20
        return 5
    if hz <= 25
        return 6
    7

// The rate the part samples at in hertz in normal mode; 0 in forced and sleep
// mode, where it measures on demand or not at all, and when it does not
// answer.
pub fn rate_read<P: Bmm150Port>(p: P) -> Int [hw]
    let v = reg_read(p, OPMODE) ?? OPMODE_MODE_MASK
    if mode_of_opmode(v) != BmmNormal
        return 0
    rate_hz_of_code((v >> 3) & 7)

// Sets the slowest rate at or above `hz` and leaves the mode: the rate the
// part took, or 0 when it did not take it.
pub fn rate_write<P: Bmm150Port>(p: P, hz: Int) -> Int [hw]
    let code = code_for_rate(hz)
    if not reg_update(p, OPMODE, OPMODE_ODR_MASK, code << 3)
        return 0
    rate_hz_of_code(code)

// ── Repetitions and presets ──────────────────────────────────────────

// The repetitions on X and Y that a REPXY value means: 1 + 2 * REPXY
// (Table 24).
pub fn rep_xy_of(reg: Int) -> Int
    1 + 2 * reg

// The repetitions on Z that a REPZ value means: 1 + REPZ (Table 26).
pub fn rep_z_of(reg: Int) -> Int
    1 + reg

// The time of one forced measurement in microseconds for `nxy` repetitions
// on X and Y and `nz` on Z (§ 4.2.4): 145 us each for the first, 500 us each
// for the second, and 980 us.
pub fn forced_time_us(nxy: Int, nz: Int) -> Int
    145 * nxy + 500 * nz + 980

// The repetitions on X and Y the part is set to; 0 when it does not answer.
pub fn rep_xy_read<P: Bmm150Port>(p: P) -> Int [hw]
    match reg_read(p, REP_XY)
        Some(v) => rep_xy_of(v)
        None    => 0

// The repetitions on Z the part is set to; 0 when it does not answer.
pub fn rep_z_read<P: Bmm150Port>(p: P) -> Int [hw]
    match reg_read(p, REP_Z)
        Some(v) => rep_z_of(v)
        None    => 0

// Sets the repetitions: `nxy` is held to an odd number from 1 to 511 and `nz`
// to 1 to 256, the values the registers can hold.  Whether the part took it.
pub fn rep_write<P: Bmm150Port>(p: P, nxy: Int, nz: Int) -> Bool [hw]
    reg_write(p, REP_XY, clamp((nxy - 1) / 2, 0, 255)) and reg_write(p, REP_Z, clamp(nz - 1, 0, 255))

// The repetitions on X and Y of a preset (Table 3): 3, 9, 15 and 47.
pub fn preset_xy(pr: BmmPreset) -> Int
    match pr
        BmmLowPower     => 3
        BmmRegular      => 9
        BmmEnhanced     => 15
        BmmHighAccuracy => 47

// The repetitions on Z of a preset (Table 3): 3, 15, 27 and 83.
//
// Open question, NOT VERIFIED: the SensorAPI writes 0x01, 0x07, 0x0D and 0x29
// to REPZ for these presets, and Zephyr's driver computes the register as
// (n - 1) / 2 for Z as for X and Y.  Those are about half of what the data
// sheet's formula (nZ = 1 + REPZ, Table 26) gives for the counts of Table 3.
// The driver follows the data sheet and writes 2, 14, 26 and 82.
pub fn preset_z(pr: BmmPreset) -> Int
    match pr
        BmmLowPower     => 3
        BmmRegular      => 15
        BmmEnhanced     => 27
        BmmHighAccuracy => 83

// The recommended data rate of a preset in hertz: 10, and 20 for high
// accuracy.
pub fn preset_hz(pr: BmmPreset) -> Int
    match pr
        BmmHighAccuracy => 20
        _               => 10

// Sets a preset: the repetitions and the data rate, leaving the mode.  Whether
// the part took every setting.
pub fn preset_write<P: Bmm150Port>(p: P, pr: BmmPreset) -> Bool [hw]
    rep_write(p, preset_xy(pr), preset_z(pr)) and rate_write(p, preset_hz(pr)) == preset_hz(pr)

// ── Forced measurement ───────────────────────────────────────────────

// Starts one measurement in forced mode: whether the write was acknowledged.
// The OPMODE field returns to sleep when the measurement ends, which for the
// low-power preset is within a millisecond, so the write is not read back.
//
// Fix kept: a write that is read back, as every setting here is, fails on a
// short measurement that has already ended.
pub fn forced_start<P: Bmm150Port>(p: P) -> Bool [hw]
    let Some(old) = reg_read(p, OPMODE) else return false
    p.write_reg(OPMODE, (old & (0xFF ^ OPMODE_MODE_MASK)) | (1 << 1))

// One measurement: starts forced mode, polls the data-ready flag, at most
// `FORCED_POLLS` times, and answers the sample; `None` when the part did not
// answer or no data came.
pub fn measure_forced<P: Bmm150Port>(p: P) -> ?MagNanoT [hw, mutate]
    if not trim_ready()
        if not trim_load(p)
            return None
    if not forced_start(p)
        return None
    for _i in 0..FORCED_POLLS
        if sample_ready(p)
            return sample_read(p)
    None

// ── Waiting on a host's scheduler ────────────────────────────────────
//
// The functions below are `@tier(rt)` because the package checks at the
// embedded tier, which refuses an `async fn` that is not bounded.  They wait
// on a `TimerAsync` the caller gives, since a driver value is `@value` and an
// `async fn` takes none (SPEC § 14.5): `MagnetometerAsync` cannot be
// implemented by `Bmm150`.  A program at `@tier(embedded)` arms the data-ready
// pin through `irq_arm` and the board's `AsyncEdge` instead.

// Stays an inherent function: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5,
// row "the async forms" (a `@value` driver cannot implement `MagnetometerAsync`,
// and the embedded tier refuses `async fn`).
//
// Starts one forced measurement, parks the task for the time the repetitions
// need, and answers the sample.  The part measures in the background while
// the task is parked.  If the data is not there when the time has passed the
// task parks for another millisecond, up to four times.  `None` when the part
// did not answer or no data came.
pub @tier(rt)
async fn mag_measure<P: Bmm150Port, T: TimerAsync>(p: P, t: T) -> ?MagNanoT [hw, async, mutate]
    if not trim_ready()
        if not trim_load(p)
            return None
    let nxy = rep_xy_read(p)
    let nz = rep_z_read(p)
    if nxy == 0 or nz == 0
        return None
    if not forced_start(p)
        return None
    await t.sleep_us(forced_time_us(nxy, nz))
    for _i in 0..4
        if sample_ready(p)
            return sample_read(p)
        await t.sleep_us(1000)
    None

// Parks the task until the next sample of normal mode is complete and answers
// it: the data-ready flag is polled every `period_us`, at most `tries` times.
pub @tier(rt)
async fn mag_next<P: Bmm150Port, T: TimerAsync>(p: P, t: T, period_us: Int,
                                                tries: Int) -> ?MagNanoT [hw, async, mutate]
    for _i in 0..tries
        if sample_ready(p)
            return sample_read(p)
        await t.sleep_us(period_us)
    None

// Stays an inherent function: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5,
// row "the async forms" (no board's GPIO implements `AsyncEdge`).
//
// Arms the part's data-ready pin on a rising edge through a board's pin-edge
// source: 0 when armed, a negative value when refused, and -1 for a wiring
// with no pin.  The edge resolves `f`.  The DRDY pin must be enabled by
// `drdy_pin_write`.
pub fn irq_arm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring, f: Future) -> Int [e]
    let Some(irq) = w.irq else return -1
    edge.edge_arm(irq, 0, f)

// Takes the arm back: whether it was still armed.  False for a wiring with no
// pin.
pub fn irq_disarm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring) -> Bool [e]
    let Some(irq) = w.irq else return false
    edge.edge_disarm(irq)

// ── Axes, pins and interrupts ────────────────────────────────────────

// Turns the measurement of the three axes on or off: whether the part took
// it.  The channel bits are active low; a disabled axis keeps its last value
// in the registers, and with Z off the resistance reading is 0, which makes
// the compensation of every axis answer `OVERFLOW_NT`.
pub fn axes_write<P: Bmm150Port>(p: P, x: Bool, y: Bool, z: Bool) -> Bool [hw]
    reg_update(p, AXES_PINS, PINS_CHANNELS, flag(not x, 0x08) | flag(not y, 0x10) | flag(not z, 0x20))

// Enables the data-ready pin with the given polarity (active high is the
// reset value): whether the part took it.
pub fn drdy_pin_write<P: Bmm150Port>(p: P, on: Bool, active_high: Bool) -> Bool [hw]
    reg_update(p,
        AXES_PINS,
        PINS_DRDY_EN | PINS_DRDY_POL,
        flag(on, PINS_DRDY_EN) | flag(active_high, PINS_DRDY_POL))

// Enables the interrupt pin for the threshold and overflow events, latched or
// not, with the given polarity: whether the part took it.
pub fn int_pin_write<P: Bmm150Port>(p: P, on: Bool, latched: Bool, active_high: Bool) -> Bool [hw]
    reg_update(p,
        AXES_PINS,
        PINS_INT_EN | PINS_LATCH | PINS_INT_POL,
        flag(on, PINS_INT_EN) | flag(latched, PINS_LATCH) | flag(active_high, PINS_INT_POL))

// Sets the low and the high threshold of the threshold interrupts, in the
// register's own units (§ 5.7, Tables 21 and 22): whether the part took both.
pub fn thresholds_write<P: Bmm150Port>(p: P, low: Int, high: Int) -> Bool [hw]
    reg_write(p, LOW_THS, low) and reg_write(p, HIGH_THS, high)

// Writes the interrupt enable register (Table 19) whole: bit 7 data overrun,
// bit 6 overflow, bits 5 to 3 the high threshold of Z, Y and X, bits 2 to 0 the
// low threshold of Z, Y and X.  The six threshold bits are active low, so 0x3F
// turns every threshold off, which is the reset value.  Whether the part took
// it.
pub fn int_enable_write<P: Bmm150Port>(p: P, bits: Int) -> Bool [hw]
    reg_write(p, INT_ENABLE, bits)

// The interrupt status register: the overrun and overflow flags and the
// threshold flags.  Zero when the part did not answer.
pub fn int_status<P: Bmm150Port>(p: P) -> Int [hw]
    reg_read(p, INT_STATUS) ?? 0

// What INT STATUS says of the sample, in the trait's terms: `MagOverflow` when
// the overflow flag (bit 6) is set, `MagValid` otherwise.  The flag is the
// part's own, so a program need not read `OVERFLOW_NT` in a value as one.  The
// overrun flag (bit 7) means a sample was lost before the next one, not that
// this one is bad.
pub fn status_of(int_status: Int) -> MagStatus
    if (int_status & INT_OVERFLOW) != 0
        return MagStatus.MagOverflow
    MagStatus.MagValid

// INT STATUS read on its own, in the trait's terms.  Reading it clears none of
// the data flags, unlike RHALL's DRDY.  A part that did not answer has no
// completed sample, so `MagNotReady`.
pub fn mag_status_read<P: Bmm150Port>(p: P) -> MagStatus [hw]
    match reg_read(p, INT_STATUS)
        Some(v) => status_of(v)
        None    => MagStatus.MagNotReady

// Starts one forced measurement and answers how long it takes in microseconds,
// from the repetitions the part is set to (`forced_time_us`): -1 when the part
// did not answer.  The part measures in the background and returns to sleep
// mode, so a program reads the sample once the time has passed.
pub fn mag_start_us<P: Bmm150Port>(p: P) -> Int [hw]
    if not forced_start(p)
        return -1
    let nxy = rep_xy_read(p)
    let nz = rep_z_read(p)
    if nxy == 0 or nz == 0
        return -1
    forced_time_us(nxy, nz)

// ── Self-test ────────────────────────────────────────────────────────

// Polls OPMODE until the self-test bit has cleared, at most `TEST_POLLS`
// times: whether it did.
fn wait_self_test<P: Bmm150Port>(p: P) -> Bool [hw]
    for _i in 0..TEST_POLLS
        if ((reg_read(p, OPMODE) ?? OPMODE_SELF_TEST) & OPMODE_SELF_TEST) == 0
            return true
    false

// The normal self-test (§ 4.4.1): puts the part in sleep mode, sets the
// self-test bit, waits for it to clear, and answers which axes passed as a
// mask, 1 for X, 2 for Y and 4 for Z (7 is all three).  `-1` when the part
// did not answer or the bit did not clear.  The advanced self-test (§ 4.4.2)
// is not implemented: its limits are in an application note that could not
// be fetched.
pub fn self_test_normal<P: Bmm150Port>(p: P) -> Int [hw]
    if not mode_write(p, BmmMode.BmmSleep)
        return -1
    let Some(old) = reg_read(p, OPMODE) else return -1
    if not p.write_reg(OPMODE, old | OPMODE_SELF_TEST)
        return -1
    if not wait_self_test(p)
        return -1
    var b: DevBytes = Vec.new()
    if not p.read_regs(DATA_X_LSB, 5, var b)
        return -1
    (b[0] as Int & 1) | ((b[2] as Int & 1) << 1) | ((b[4] as Int & 1) << 2)

// Whether a self-test mask says all three axes passed.
pub fn self_test_passed(mask: Int) -> Bool
    mask == 7

// ── Power and bring-up ───────────────────────────────────────────────

// Sets the power control bit: the part leaves suspend for sleep mode, and is
// readable after 3 ms.  Whether the part took it.
pub fn power_on<P: Bmm150Port>(p: P) -> Bool [hw]
    reg_write(p, POWER, POWER_CONTROL)

// Clears the power control bit: the part enters suspend mode, where it loses
// every register but POWER.  The trim data in the module is forgotten.
pub fn suspend<P: Bmm150Port>(p: P) -> Bool [hw, mutate]
    trim_clear()
    reg_write(p, POWER, 0)

// Resets every register but the trim data and POWER with the two soft reset
// bits and waits for them to clear: whether they did.  The part ignores the
// reset in suspend mode, so the power control bit must be set.
pub fn soft_reset<P: Bmm150Port>(p: P) -> Bool [hw]
    let Some(old) = reg_read(p, POWER) else return false
    if not p.write_reg(POWER, old | POWER_RESET)
        return false
    for _i in 0..RESET_POLLS
        let Some(v) = reg_read(p, POWER) else return false
        if (v & POWER_RESET) == 0
            return true
    false

// Brings the part up: the bus made ready; the power control bit set and the
// chip id waited for; a soft reset; then a full power-on reset by way of
// suspend, which the data sheet gives as the way to reset what the soft reset
// leaves (§ 5.6) and Zephyr's driver does; the trim data read; and the
// regular preset (9 repetitions on X and Y, 15 on Z), the data-ready pin
// enabled and normal mode at 10 Hz.  Answers whether the part answered as a
// BMM150 and took every setting.
//
// Fix kept: the chip id is not readable until the power control bit is set
// and the 3 ms have passed, so a bring-up that reads it first finds no part;
// the soft reset is ignored in suspend mode, so the power bit is set first
// (Zephyr's `bmm150_full_por`).
pub fn start<P: Bmm150Port>(p: P) -> Bool [hw, mutate]
    if not p.setup()
        return false
    trim_clear()
    if not power_on(p)
        return false
    if not wait_chip_id(p)
        return false
    if not soft_reset(p)
        return false
    if not suspend(p)
        return false
    if not power_on(p)
        return false
    if not wait_chip_id(p)
        return false
    if not trim_load(p)
        return false
    preset_write(p, BmmPreset.BmmRegular) and reg_write(p, AXES_PINS, PINS_DRDY_EN | PINS_DRDY_POL | PINS_LATCH | PINS_INT_POL) and reg_update(p, OPMODE, OPMODE_MODE_MASK, 0)

// ── The part on an I2C bus ───────────────────────────────────────────

// A BMM150 on a board's I2C bus at the address `w.addr`, 0x10 to 0x13, with
// the board's GPIO for the data-ready line.
pub @value
struct Bmm150
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Bmm150Port for Bmm150
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Bmm150
    // The part at `w.addr` on the board's I2C bus, as a board's device table
    // builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Bmm150
        Bmm150 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw, mutate]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The operation mode.
    fn mode(self) -> BmmMode [hw]
        mode_read(self)

    // Sets the operation mode (`mode_write`).
    fn set_mode(self, m: BmmMode) -> Bool [hw]
        mode_write(self, m)

    // Sets the slowest rate at or above `hz` (`rate_write`).
    fn set_rate_hz(self, hz: Int) -> Int [hw]
        rate_write(self, hz)

    // Sets a preset (`preset_write`).
    fn set_preset(self, pr: BmmPreset) -> Bool [hw]
        preset_write(self, pr)

    // One forced measurement (`measure_forced`).
    fn measure(self) -> ?MagNanoT [hw, mutate]
        measure_forced(self)

    // The normal self-test's mask of passing axes (`self_test_normal`).
    fn self_test(self) -> Int [hw]
        self_test_normal(self)

impl Magnetometer[hw, mutate] for Bmm150
    // Plain `self` holds no state, so the trim data is module state and the
    // effect is [hw, mutate]: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5, row
    // "Magnetometer".  `mag_range` keeps the trait's body (`None`): the part's
    // range is fixed per axis (±1300 uT on X and Y, ±2500 uT on Z), not one of
    // the gauss ranges `MagRange` names.
    fn mag_read(self) -> ?MagNanoT [hw, mutate]
        sample_read(self)

    fn mag_ready(self) -> Bool [hw, mutate]
        sample_ready(self)

    fn mag_rate_hz(self) -> Int [hw, mutate]
        rate_read(self)

    fn mag_start(self) -> Int [hw, mutate]
        mag_start_us(self)

    fn mag_status(self) -> MagStatus [hw, mutate]
        mag_status_read(self)

impl Identifiable[hw] for Bmm150
    // CHIP_ID, 0x32; the part keeps no revision register, so `rev` is `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// A BMM150 on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the data-ready line.
pub @value
struct Bmm150Spi
    bus: BoardSpi
    pins: BoardGpio
    w: DeviceWiring

impl Bmm150Port for Bmm150Spi
    fn setup(self) -> Bool [hw]
        spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Bmm150Spi
    // The part on the board's SPI bus with the chip select `w.cs`, as a
    // board's device table builds it.  Nothing is sent.
    fn attach(bus: BoardSpi, pins: BoardGpio, w: DeviceWiring) -> Bmm150Spi
        Bmm150Spi { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw, mutate]
        start(self)

    // One register's byte, `None` when the wiring has no chip select.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The operation mode.
    fn mode(self) -> BmmMode [hw]
        mode_read(self)

    // Sets the operation mode (`mode_write`).
    fn set_mode(self, m: BmmMode) -> Bool [hw]
        mode_write(self, m)

    // Sets the slowest rate at or above `hz` (`rate_write`).
    fn set_rate_hz(self, hz: Int) -> Int [hw]
        rate_write(self, hz)

    // Sets a preset (`preset_write`).
    fn set_preset(self, pr: BmmPreset) -> Bool [hw]
        preset_write(self, pr)

    // One forced measurement (`measure_forced`).
    fn measure(self) -> ?MagNanoT [hw, mutate]
        measure_forced(self)

    // The normal self-test's mask of passing axes (`self_test_normal`).
    fn self_test(self) -> Int [hw]
        self_test_normal(self)

impl Magnetometer[hw, mutate] for Bmm150Spi
    // Plain `self` holds no state, so the trim data is module state and the
    // effect is [hw, mutate]: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5, row
    // "Magnetometer".  `mag_range` keeps the trait's body (`None`): the part's
    // range is fixed per axis (±1300 uT on X and Y, ±2500 uT on Z), not one of
    // the gauss ranges `MagRange` names.
    fn mag_read(self) -> ?MagNanoT [hw, mutate]
        sample_read(self)

    fn mag_ready(self) -> Bool [hw, mutate]
        sample_ready(self)

    fn mag_rate_hz(self) -> Int [hw, mutate]
        rate_read(self)

    fn mag_start(self) -> Int [hw, mutate]
        mag_start_us(self)

    fn mag_status(self) -> MagStatus [hw, mutate]
        mag_status_read(self)

impl Identifiable[hw] for Bmm150Spi
    // CHIP_ID, 0x32; the part keeps no revision register, so `rev` is `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
